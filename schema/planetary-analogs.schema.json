{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlejandroV-alpha/nasa-space-apps-2026-planetary-analogs/schema/planetary-analogs.schema.json",
  "title": "Planetary analogs dataset",
  "description": "Contrato de datos compartido entre ciencia (Persona 2), frontend (Persona 1) e integración (Persona 3). Ver schema/README.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "datasetId", "generatedAt", "status", "sources", "methods", "referenceRegions", "sites"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": {
      "description": "Versión del contrato (semver). Un cambio incompatible sube el número mayor.",
      "const": "1.0.0"
    },
    "datasetId": { "$ref": "#/$defs/id" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": {
      "description": "fixture: datos de ejemplo; draft: mezcla de datos reales y pendientes; release: solo análisis reales, sin fixtures.",
      "enum": ["fixture", "draft", "release"]
    },
    "notes": { "type": "string" },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "methods": { "type": "array", "items": { "$ref": "#/$defs/method" } },
    "referenceRegions": { "type": "array", "items": { "$ref": "#/$defs/referenceRegion" } },
    "sites": { "type": "array", "items": { "$ref": "#/$defs/site" } }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "idList": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "nonEmptyText": { "type": "string", "minLength": 1 },
    "evidenceStatus": {
      "description": "fixture: inventado para desarrollo; candidate_investigated: hipótesis con fuentes, sin cálculo; analysis_computed: métricas calculadas de forma reproducible.",
      "enum": ["fixture", "candidate_investigated", "analysis_computed"]
    },
    "targetBody": { "enum": ["moon", "mars"] },
    "position": {
      "description": "[longitud, latitud] en grados.",
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": -180, "maximum": 360 },
        { "type": "number", "minimum": -90, "maximum": 90 }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "pointGeometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "Point" },
        "coordinates": { "$ref": "#/$defs/position" }
      }
    },
    "polygonGeometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "Polygon" },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 4,
            "items": { "$ref": "#/$defs/position" }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "agency", "product", "version", "url", "accessedAt", "license", "attribution", "crs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "agency": { "$ref": "#/$defs/nonEmptyText" },
        "product": { "$ref": "#/$defs/nonEmptyText" },
        "version": { "$ref": "#/$defs/nonEmptyText" },
        "doi": { "type": "string", "pattern": "^10\\.\\d{4,9}/\\S+$" },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "file": { "type": "string" },
        "accessedAt": { "type": "string", "format": "date" },
        "observationInterval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": { "type": "string", "format": "date" },
            "end": { "type": "string", "format": "date" }
          }
        },
        "nativeResolutionM": { "type": "number", "exclusiveMinimum": 0 },
        "license": { "$ref": "#/$defs/nonEmptyText" },
        "attribution": { "$ref": "#/$defs/nonEmptyText" },
        "crs": {
          "description": "Sistema de coordenadas del producto, p. ej. EPSG:4326 o IAU_2015:30100.",
          "$ref": "#/$defs/nonEmptyText"
        }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/nonEmptyText" },
        "description": { "$ref": "#/$defs/nonEmptyText" },
        "resampling": { "type": "string" },
        "windowM": { "type": "number", "exclusiveMinimum": 0 },
        "documentationUrl": { "type": "string", "format": "uri" }
      }
    },
    "metricKey": {
      "description": "Unidad obligatoria por clave: slope-median y slope-p90 en deg; relief-p95-p5 y roughness en m; lst-day-night-diff en K.",
      "enum": ["slope-median", "slope-p90", "relief-p95-p5", "roughness", "lst-day-night-diff"]
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value", "unit", "status", "sourceIds", "methodId", "analysisScaleM", "validCoverageFraction"],
      "properties": {
        "key": { "$ref": "#/$defs/metricKey" },
        "value": { "type": ["number", "null"] },
        "unit": { "enum": ["deg", "m", "K"] },
        "status": {
          "description": "computed: calculado; fixture: valor de ejemplo; missing: sin dato (value null); not_applicable: la métrica no aplica (value null).",
          "enum": ["computed", "fixture", "missing", "not_applicable"]
        },
        "missingReason": { "$ref": "#/$defs/nonEmptyText" },
        "sourceIds": { "$ref": "#/$defs/idList" },
        "methodId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "analysisScaleM": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "validCoverageFraction": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["missing", "not_applicable"] } } },
          "then": {
            "required": ["missingReason"],
            "properties": { "value": { "type": "null" } }
          },
          "else": {
            "not": { "required": ["missingReason"] },
            "properties": {
              "value": { "type": "number" },
              "methodId": { "$ref": "#/$defs/id" },
              "analysisScaleM": { "type": "number" },
              "validCoverageFraction": { "type": "number" },
              "sourceIds": { "type": "array", "minItems": 1 }
            }
          }
        }
      ]
    },
    "referenceRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "targetBody", "crs", "center", "geometry", "description", "sourceIds", "evidenceStatus", "metrics"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/nonEmptyText" },
        "targetBody": { "$ref": "#/$defs/targetBody" },
        "crs": {
          "description": "Coordenadas planetocéntricas del cuerpo, nunca WGS84 terrestre. Luna: IAU_2015:30100; Marte: IAU_2015:49900.",
          "enum": ["IAU_2015:30100", "IAU_2015:49900"]
        },
        "center": { "$ref": "#/$defs/pointGeometry" },
        "geometry": { "$ref": "#/$defs/polygonGeometry" },
        "description": { "$ref": "#/$defs/nonEmptyText" },
        "selectionRationale": { "type": "string" },
        "sourceIds": { "$ref": "#/$defs/idList" },
        "evidenceStatus": { "$ref": "#/$defs/evidenceStatus" },
        "metrics": { "type": "array", "items": { "$ref": "#/$defs/metric" } }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetBody", "referenceRegionId", "testUseCase", "interpretation", "limitations", "evidenceStatus"],
      "properties": {
        "targetBody": { "$ref": "#/$defs/targetBody" },
        "referenceRegionId": { "$ref": "#/$defs/id" },
        "testUseCase": { "$ref": "#/$defs/nonEmptyText" },
        "interpretation": { "$ref": "#/$defs/nonEmptyText" },
        "limitations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyText" } },
        "evidenceStatus": { "$ref": "#/$defs/evidenceStatus" }
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "country", "kind", "geometry", "studyArea", "summary", "evidenceStatus", "sourceIds", "assessments", "metrics"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/nonEmptyText" },
        "country": {
          "description": "Código ISO 3166-1 alfa-2.",
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "kind": {
          "description": "candidate: candidato propio; known_reference: análogo ya conocido usado como contexto.",
          "enum": ["candidate", "known_reference"]
        },
        "geometry": {
          "description": "Punto representativo en WGS84 (EPSG:4326), [lon, lat].",
          "$ref": "#/$defs/pointGeometry"
        },
        "studyArea": {
          "description": "Polígono del área analizada en WGS84 (EPSG:4326).",
          "$ref": "#/$defs/polygonGeometry"
        },
        "summary": { "$ref": "#/$defs/nonEmptyText" },
        "evidenceStatus": { "$ref": "#/$defs/evidenceStatus" },
        "sourceIds": { "$ref": "#/$defs/idList" },
        "assessments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/assessment" } },
        "metrics": { "type": "array", "items": { "$ref": "#/$defs/metric" } }
      }
    }
  }
}
